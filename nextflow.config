// output
params.outdir = "${projectDir}/results"

// process resources
process {
	cpus = 2
	memory = '4 GB'
	time = '1h'
}

// Apptainer settings
apptainer {
	enabled = true
	autoMounts = true
	// cache the images on scratch -- to avoid storage issues
	cacheDir = "/scratch/${System.getenv('USER')}/apptainer_cache"
}

// execution profile
profiles {
	slurm {
		includeConfig 'slurm_config/slurm.config'
	}

	local {
		process.executor = 'local'
	}
}

// performance reports
report {
	enabled = true
	overwrite = true
	file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
	enabled = true
	overwrite = true
	file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
	enabled = true
	overwrite = true
	file = "${params.outdir}/pipeline_info/pipeline_dag.png"
}

