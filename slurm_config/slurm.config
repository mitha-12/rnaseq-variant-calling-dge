// process
process {
	executor = 'slurm'
	queue = 'short'
	
	errorStrategy = 'retry'
	maxRetries = 2

	// baseline default
	cpus = 4
	memory = '8 GB'
	time = '4h'

	// memory hungry resources overrides
	// --- STAR ---
	withName: 'STAR_INDEX|STAR_ALIGN' {
		cpus = 8
		memory = '32 GB'
		time = '8h'
	}

	// --- GATK pre-processing ---
	withName: 'PREPARE_REFERENCE' {
		cpus = 2
		memory = '8 GB'
		time = '1h'
	}

	// --- GATK-Variant calling ---
	withName: 'HAPLOTYPE_CALLER|SPLIT_NCIGAR' {
		cpus = 4
		memory = '16 GB'
		time = '8h'
	}
	
	// --- Joint Genotyping ---
	withName: 'GENOMICS_DB_IMPORT|GENOTYPE_GVCFS' {
		cpus = 8
		memory = '32 GB'
		time = '24h'
	}

	// --- Variant Filteration ---
	withName: 'VARIANT_FILTRATION' {
		cpus = 2
		memory = '8 GB'
		time = '2h'
	}

	// --- Variant Annotation - Download sources ---
	withName: 'FUNCOTATOR_DATA_SOURCES' {
		cpus = 4
		memory = '16 GB'
		time = '6h'
	}

	// ---Variant Annotation ---
	withName: 'FUNCOTATOR' {
		cpus = 4
		memory = '16 GB'
		time = '6h'
	}
	
	// --- FeatureCounts ---
	withName: 'FEATURECOUNTS' {
		cpus = 4
		memory = '8 GB'
		time = '1h'
	}	
	
	// --- Plots ---
	withName: 'PLOT_DESEQ2' {
		cpus = 2
		memory = '8 GB'
		time = '1h'
	}

	// --- GO ---
	withName: 'GO_ENRICHMENT' {
		cpus = 2
		memory = '8 GB'
		time = '1h'
	}
	
	// --- Network analysis ---
	withName: 'NETWORK_PLOTS' {
		cpus = 2
		memory = '8 GB'
		time = '1h'
	}

	// --- QC, Trimming ---
	withName: 'FASTQC|MULTIQC|TRIM_GALORE' {
		cpus = 2
		memory = '4 GB'
		time = '2h'
	}
}

// safety limit
executor{
	queueSize = 20
}

